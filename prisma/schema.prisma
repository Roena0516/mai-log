generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nickname      String?   @unique
  title         String?
  playCountTotal   Int    @default(0)
  playCountVersion Int    @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  records       Record[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Record {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String
  achievement    Int
  difficultyType String
  isDx           Boolean
  clearMark      String   @default("clear")
  sync           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RecentLog {
  id             String   @id @default(cuid())
  userId         String
  title          String
  achievement    Int
  difficultyType String
  isDx           Boolean
  clearMark      String   @default("clear")
  sync           String?
  createdAt      DateTime @default(now())
}

model Song {
  id       String  @id @default(cuid())
  title    String
  artist   String
  catcode  String
  version  Int
  imageUrl String
  charts   Chart[]
  @@unique([title, artist])
}

model Chart {
  id             String  @id @default(cuid())
  songId         String
  song           Song    @relation(fields: [songId], references: [id])
  isDx           Boolean
  difficultyType String
  level          String
  levelValue     Float
  isNewVersion   Boolean @default(false)
  @@unique([songId, isDx, difficultyType])
}